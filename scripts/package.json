{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hello": "tsx ./src/hello.ts",
    "seed:foundation": "tsx ./src/seed-foundation.ts",
    "test:unit": "tsx --test ./src/tests/unit.test.ts",
    "test:database": "tsx --test ./src/tests/database.test.ts",
    "test:api": "tsx --test ./src/tests/api.test.ts",
    "test:ui": "tsx --test ./src/tests/ui.test.ts",
    "test:smoke": "tsx --test ./src/tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:"
  }
}
